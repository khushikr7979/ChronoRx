# ChronoRx Tech Backend Configuration Template
# Copy this file to .env and fill in environment-specific values

# Application
APP_NAME=ChronoRx Tech
APP_ENV=development
SECRET_KEY=your_jwt_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Local SQLite: sqlite:///./chronorx.db
# PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./chronorx.db

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_FALLBACK_MODE=true

# OCR Configuration
# Custom Tesseract path if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe or /usr/bin/tesseract)
TESSERACT_CMD=
OCR_FALLBACK_MODE=true

# External Medical APIs
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_BASE_URL=https://api.fda.gov/drug

# File Storage
UPLOAD_DIR=./uploads
GENERATED_REPORTS_DIR=./generated_reports
MAX_UPLOAD_SIZE_MB=15

# Security / CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
